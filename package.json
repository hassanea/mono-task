    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.87.0",
    "eslint-plugin-vue": "~10.11.1",
    "fontaine": "^1.0.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.87.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
